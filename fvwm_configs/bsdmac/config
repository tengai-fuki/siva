# ============================================================
# MINIMAL FVWM DEFINES
# ============================================================

Colorset 10 bg #ff0033
Colorset 11 bg #8b0000
Colorset 12 fg #ffffff, bg #000000, hi #000000, sh #000000, Plain
Colorset 20 fg #ffffff, bg #ff5f57, hi #ff5f57, sh #ff5f57, Plain
Colorset 21 fg #ffffff, bg #febc2e, hi #febc2e, sh #febc2e, Plain
Colorset 22 fg #ffffff, bg #28c840, hi #28c840, sh #28c840, Plain
Colorset 23 fg #ffffff, bg #007aff, hi #007aff, sh #007aff, Plain

# ------------------------------------------------------------
# Keybinds
# ------------------------------------------------------------

Key Return A 4 Exec kitty
Key F5 R N FukiNuke
Key F4 A M Close
Key L A 4 Exec exec /home/tengai/.config/i3lock/i3lock.conf -c 000000

DestroyFunc FukiNuke
AddToFunc FukiNuke
+ I Exec killall -q pcmanfm tint2
+ I Exec sh -c "sleep 0.5 && pcmanfm --desktop &"
+ I Exec sh -c "sleep 1.2 && tint2 &"
+ I Exec xsetroot -cursor_name left_ptr
+ I Restart

Key S A 4S Exec flameshot gui
Key Print A N Exec flameshot gui
Key D A 4 All (CurrentPage, !Iconic) Iconify

Key 1 A C GotoDesk 0 0
Key 2 A C GotoDesk 0 1
Key 3 A C GotoDesk 0 2
Key 4 A C GotoDesk 0 3

# ------------------------------------------------------------
# Button actions
# ------------------------------------------------------------

Mouse 1 1 A Close
Mouse 1 3 A Iconify
Mouse 1 5 A Maximize

# ============================================================
# i3 TARZI OTOMATİK TILING (Sadece Config İle)
# ============================================================

# Pencereleri oranlayarak ekrana dizen ana makro
#DestroyFunc AutoTile
#AddToFunc AutoTile
#+ I FvwmRearrange -tile

# Olay dinleyicisi: Yeni pencere açıldığında ve kapandığında AutoTile çalışsın
#DestroyModuleConfig FvwmEvent-Tiler: *
#*FvwmEvent-Tiler: add_window AutoTile
#*FvwmEvent-Tiler: destroy_window AutoTile

# Mavi butona basarsan dizilimi manuel olarak zorla tetikler
#Mouse 1 7 A AutoTile

# ------------------------------------------------------------
# Window controls
# ------------------------------------------------------------

MenuStyle WindowList Mwm
MenuStyle WindowList SelectOnRelease Alt_L
Key Tab A M WindowList Root c c NoDeskSort, SelectOnRelease Alt_L, CurrentAtEnd

DestroyFunc MoveClickX
AddToFunc MoveClickX
+ M Move
+ C Raise
+ D Maximize

Mouse 1 T A MoveClickX Move Raise Maximize

# ------------------------------------------------------------
# Taskbar / Window list
# ------------------------------------------------------------

Style tint2 NoTitle, NoHandles, BorderWidth 0, Sticky, StaysOnTop
Style "spacefm" StaysOnBottom, WindowListSkip, CirculateSkip
Style "Spacefm" GrabFocus, EWMHGrabFocus, StaysOnTop
Style "tint2" StaysOnBottom

EwmhBaseStruts 0 0 35 0

AddToFunc StartFunction
+ I Module FvwmEvent FvwmEvent-Tiler

# ------------------------------------------------------------
# Window movement
# ------------------------------------------------------------

Style * NoIcon
Style * SnapAttraction 32 ScreenAll
Style * FPFocusByFunctionWarpPointerOff
Style * ClickToFocus
Style * !UsePPosition, !UseUSPosition, PositionPlacement 0p 30p
Style tint2 UsePPosition

Mouse 1 A M Move
Mouse 3 A M Resize

# ------------------------------------------------------------
# Window list
# ------------------------------------------------------------

DestroyFunc WindowListFunc

AddToFunc WindowListFunc
+ I Iconify off
+ I FlipFocus
+ I Raise

# ============================================================
# macOS-style decoration
# ============================================================

DestroyDecor BSDMac

AddToDecor BSDMac

+ ButtonStyle All Active Colorset 12 -- flat
+ ButtonStyle All Inactive Colorset 12 -- flat
+ ButtonStyle All -- UseTitleStyle Flat

+ TitleStyle Height 28
+ TitleStyle Active Colorset 12 -- flat
+ TitleStyle Inactive Colorset 12 -- flat

# ------------------------------------------------------------
# Only left-side buttons
# ------------------------------------------------------------

Style * !Button 2
Style * !Button 4
Style * !Button 6
Style * !Button 8

Style * Button 1
Style * Button 3
Style * Button 5
Style * Button 7

# ------------------------------------------------------------
# Empty titlebar mouse actions
# ------------------------------------------------------------

Mouse 1 R A Nop
Mouse 2 R A Nop
Mouse 3 R A Nop

# ------------------------------------------------------------
# Borders
# ------------------------------------------------------------

+ BorderStyle Simple -- HiddenHandles NoInset

+ BorderStyle Active Colorset 10 -- flat
+ BorderStyle Inactive Colorset 11 -- flat

Style * HandleWidth 3
Style * BorderWidth 3
Style * BorderColorset 11
Style * HilightBorderColorset 10
Style * Colorset 12
Style * HilightColorset 12

Style * UseDecor BSDMac

